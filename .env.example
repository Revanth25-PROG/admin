# ==============================================================================
# STUDYVERSE Cloud & Backend Environment Configuration
# ==============================================================================
# NOTE: All settings can ALSO be configured at runtime directly inside the 
# application under: Settings -> Connect Live Backend (no rebuild required).
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1: Custom Hosted REST API Backend (Node.js/Express, Python/FastAPI, Go)
# Compatible with Render, Railway, Fly.io, AWS, Heroku, or Self-Hosted VPS
# ------------------------------------------------------------------------------
# Set this to your live deployed backend URL (without trailing slash):
VITE_BACKEND_URL=https://studyverse-backend.onrender.com

# Optional API authentication key/token if your backend requires Bearer auth:
VITE_API_KEY=your-optional-api-key-here

# ------------------------------------------------------------------------------
# OPTION 2: Supabase PostgreSQL Cloud
# ------------------------------------------------------------------------------
# If you prefer Supabase Cloud PostgreSQL, set these:
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# OPTION 3: Offline-First Local Demo Mode
# ------------------------------------------------------------------------------
# Leave all variables blank to run in full Local Demo Mode with complete 
# browser localStorage persistence, mock test generation, and analytics.
